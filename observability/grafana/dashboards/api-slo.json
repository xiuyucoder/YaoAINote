{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "API request rate by outcome",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (outcome) (rate(yaoainote_http_server_requests_total{route!=\"/metrics\"}[$__rate_interval]))", "legendFormat": "{{outcome}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "API error ratio (99% SLO budget)",
      "description": "Service and dependency errors consume the availability SLO; client and cancelled requests are excluded.",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(yaoainote_http_server_requests_total{route!=\"/metrics\",outcome=~\"server_error|dependency_error\"}[$__rate_interval])) / clamp_min(sum(rate(yaoainote_http_server_requests_total{route!=\"/metrics\"}[$__rate_interval])), 0.001)", "legendFormat": "error ratio", "refId": "A" },
        { "expr": "vector(0.01)", "legendFormat": "1% SLO budget", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "API latency p95 by route",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, route) (rate(yaoainote_http_server_duration_bucket{route!=\"/metrics\"}[$__rate_interval])))", "legendFormat": "{{route}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "API latency p99 by route",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le, route) (rate(yaoainote_http_server_duration_bucket{route!=\"/metrics\"}[$__rate_interval])))", "legendFormat": "{{route}}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "API availability (last 30m)",
      "id": 5,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.99 }, { "color": "green", "value": 0.999 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "expr": "1 - (sum(increase(yaoainote_http_server_requests_total{route!=\"/metrics\",outcome=~\"server_error|dependency_error\"}[30m])) / clamp_min(sum(increase(yaoainote_http_server_requests_total{route!=\"/metrics\"}[30m])), 1))", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP requests by status code",
      "id": 6,
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 55 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (status_code) (rate(yaoainote_http_server_requests_total{route!=\"/metrics\"}[$__rate_interval]))", "legendFormat": "{{status_code}}", "refId": "A" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": [ "api", "slo", "observability" ],
  "time": { "from": "now-6h", "to": "now" },
  "title": "YaoAINote API & SLO",
  "uid": "yaoainote-api-slo",
  "version": 1
}
