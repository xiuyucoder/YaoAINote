{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "RAG result rate by context outcome",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (no_context) (rate(yaoainote_rag_chat_duration_count{outcome=\"success\"}[$__rate_interval]))", "legendFormat": "no context: {{no_context}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "No-context rate",
      "description": "A high no-context rate is a privacy-safe search coverage and retrieval-quality signal.",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(yaoainote_rag_chat_duration_count{outcome=\"success\",no_context=\"true\"}[$__rate_interval])) / clamp_min(sum(rate(yaoainote_rag_chat_duration_count{outcome=\"success\"}[$__rate_interval])), 0.001)", "legendFormat": "no-context rate", "refId": "A" },
        { "expr": "vector(0.25)", "legendFormat": "alert threshold", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average retrieved chunks",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (outcome) (rate(yaoainote_rag_retrieved_chunks_sum[$__rate_interval])) / clamp_min(sum by (outcome) (rate(yaoainote_rag_retrieved_chunks_count[$__rate_interval])), 0.001)", "legendFormat": "{{outcome}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Vector query latency p95 and dependency-error rate",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [ { "matcher": { "id": "byName", "options": "dependency error rate" }, "properties": [ { "id": "unit", "value": "percentunit" }, { "id": "max", "value": 1 } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(yaoainote_vector_db_duration_bucket{operation=\"query\"}[$__rate_interval])))", "legendFormat": "query p95", "refId": "A" },
        { "expr": "sum(rate(yaoainote_vector_db_duration_count{operation=\"query\",outcome=\"dependency_error\"}[$__rate_interval])) / clamp_min(sum(rate(yaoainote_vector_db_duration_count{operation=\"query\"}[$__rate_interval])), 0.001)", "legendFormat": "dependency error rate", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average vectors returned per query",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(yaoainote_vector_db_vectors_sum{operation=\"query\"}[$__rate_interval])) / clamp_min(sum(rate(yaoainote_vector_db_vectors_count{operation=\"query\"}[$__rate_interval])), 0.001)", "legendFormat": "vectors returned", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Query embedding latency p95",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(yaoainote_embeddings_duration_bucket{input_type=\"query\"}[$__rate_interval])))", "legendFormat": "query embedding p95", "refId": "A" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": [ "search", "quality", "rag", "observability" ],
  "time": { "from": "now-6h", "to": "now" },
  "title": "YaoAINote Search Quality",
  "uid": "yaoainote-search-quality",
  "version": 1
}
