{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Document operation rate by operation and outcome",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 50 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (operation, outcome) (rate(yaoainote_documents_operations_total[$__rate_interval]))", "legendFormat": "{{operation}} / {{outcome}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Upload service failure ratio",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(yaoainote_documents_operations_total{operation=\"upload\",outcome=~\"server_error|dependency_error\"}[$__rate_interval])) / clamp_min(sum(rate(yaoainote_documents_operations_total{operation=\"upload\"}[$__rate_interval])), 0.001)", "legendFormat": "upload service failures", "refId": "A" },
        { "expr": "vector(0.20)", "legendFormat": "alert threshold", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Parsing latency p95 by file type",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, file_extension) (rate(yaoainote_documents_parse_duration_bucket[$__rate_interval])))", "legendFormat": "{{file_extension}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingestion dependency latency p95",
      "description": "Embedding is measured per input batch and vector upsert is measured per provider batch.",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(yaoainote_embeddings_duration_bucket{input_type=\"document\"}[$__rate_interval])))", "legendFormat": "document embedding", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(yaoainote_vector_db_duration_bucket{operation=\"upsert\"}[$__rate_interval])))", "legendFormat": "vector upsert", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Upload size p95 by file type",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, file_extension) (rate(yaoainote_documents_upload_bytes_bucket[$__rate_interval])))", "legendFormat": "{{file_extension}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average chunks per parsed document",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (file_extension) (rate(yaoainote_documents_chunks_sum[$__rate_interval])) / clamp_min(sum by (file_extension) (rate(yaoainote_documents_chunks_count[$__rate_interval])), 0.001)", "legendFormat": "{{file_extension}}", "refId": "A" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": [ "upload", "ingestion", "observability" ],
  "time": { "from": "now-6h", "to": "now" },
  "title": "YaoAINote Upload Ingestion",
  "uid": "yaoainote-upload-ingestion",
  "version": 1
}
