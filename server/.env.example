# Backend
PORT=3001

# API key the frontend must send in the x-api-key header
APP_API_KEY=yao168

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the API host (e.g. for relay services like UIUIAPI).
# Leave unset to use the official Anthropic endpoint.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Opt-in live LLM diagnostic test. It sends a minimal request and is disabled by default.
# RUN_LLM_LIVE_TESTS=false

# When true, /api/chat returns an SSE response. When false or unset, it returns JSON.
# Restart the server after changing this setting.
LLM_STREAMING_ENABLED=false

# Voyage AI — https://www.voyageai.com/
VOYAGE_API_KEY=pa-...

# Pinecone — https://app.pinecone.io/
# Create a serverless index, dimension 1024, metric cosine
PINECONE_API_KEY=...
PINECONE_INDEX=yaoainote

# CORS — comma-separated list of allowed origins (dev default below)
CORS_ORIGINS=http://localhost:5173

# Optional: where to store the SQLite metadata DB.
# In dev, leave unset (defaults to server/data/).
# In Railway, set to your mounted volume path, e.g. DATA_DIR=/data
# DATA_DIR=/data

# Observability — non-secret configuration only. Exporter authentication must
# use platform workload identity; never place telemetry credentials in .env.
# TELEMETRY_ENABLED=false
# OTEL_SERVICE_NAME=yaoainote-server
# OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.example.com
# TELEMETRY_TRACE_SAMPLE_RATIO=0.10
# LOG_LEVEL=info
#
# Restricted incident-only raw capture. It is disabled by default, encrypted,
# and must be deleted automatically after exactly seven days (see docs/observability.md).
# TELEMETRY_RAW_DEBUG_ENABLED=false
# TELEMETRY_RAW_DEBUG_RETENTION_DAYS=7
