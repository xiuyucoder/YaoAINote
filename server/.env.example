# Backend
PORT=3000

# API key the frontend must send in the x-api-key header
APP_API_KEY=change-me-to-a-random-string

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the API host (e.g. for relay services like UIUIAPI).
# Leave unset to use the official Anthropic endpoint.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Voyage AI — https://www.voyageai.com/
VOYAGE_API_KEY=pa-...

# Pinecone — https://app.pinecone.io/
# Create a serverless index, dimension 1024, metric cosine
PINECONE_API_KEY=...
PINECONE_INDEX=yaoainote

# CORS — comma-separated list of allowed origins (dev default below)
CORS_ORIGINS=http://localhost:5173

# Optional: where to store the SQLite metadata DB.
# In dev, leave unset (defaults to server/data/).
# In Railway, set to your mounted volume path, e.g. DATA_DIR=/data
# DATA_DIR=/data
